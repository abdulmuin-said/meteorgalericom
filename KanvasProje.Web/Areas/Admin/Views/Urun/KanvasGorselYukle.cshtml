@{
    ViewData["Title"] = "Kanvas Görsellerini Yükle";
}

<style>
    .ca-upload-container {
        max-width: 760px;
        margin: 0 auto;
    }

    .ca-upload-card {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.03);
        overflow: hidden;
    }

    .ca-upload-card-header {
        background: linear-gradient(135deg, #1B2A4A 0%, #444b19 100%);
        color: #ffffff;
        padding: 18px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .ca-upload-card-title {
        font-size: 1.15rem;
        font-weight: 600;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
        color: #ffffff;
    }

    .ca-upload-card-body {
        padding: 28px;
    }

    .ca-upload-notice {
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-left: 4px solid #10b981;
        border-radius: 10px;
        padding: 14px 18px;
        color: #166534;
        font-size: 0.92rem;
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 24px;
    }

    .ca-upload-dropzone {
        border: 2px dashed #cbd5e1;
        background: #f8fafc;
        border-radius: 14px;
        padding: 34px 20px;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s ease;
        margin-bottom: 8px;
    }

    .ca-upload-dropzone:hover, .ca-upload-dropzone.dragover {
        border-color: #6366f1;
        background: #f5f3ff;
    }

    .ca-upload-drop-icon {
        font-size: 2.5rem;
        color: #6366f1;
        margin-bottom: 10px;
    }

    .ca-upload-drop-title {
        font-weight: 600;
        color: #1e293b;
        font-size: 1rem;
        margin-bottom: 4px;
    }

    .ca-upload-drop-sub {
        font-size: 0.84rem;
        color: #64748b;
    }

    .ca-selected-file-bar {
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 12px 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 14px;
        font-size: 0.9rem;
    }

    .ca-progress-wrap {
        height: 22px;
        border-radius: 11px;
        background: #e2e8f0;
        overflow: hidden;
        margin-top: 20px;
        box-shadow: inset 0 2px 4px rgba(0,0,0,0.06);
    }

    .ca-progress-bar {
        height: 100%;
        width: 0%;
        background: linear-gradient(90deg, #4f46e5 0%, #06b6d4 100%);
        color: #fff;
        font-weight: 600;
        font-size: 0.78rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: width 0.25s ease;
    }

    .ca-upload-btn {
        background: linear-gradient(135deg, #1B2A4A 0%, #444b19 100%);
        color: #ffffff;
        border: none;
        border-radius: 10px;
        padding: 13px 26px;
        font-weight: 600;
        font-size: 0.95rem;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s ease;
        cursor: pointer;
        margin-top: 22px;
    }

    .ca-upload-btn:hover:not(:disabled) {
        opacity: 0.92;
        transform: translateY(-1px);
        color: #ffffff;
    }

    .ca-upload-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }
</style>

<div class="container-fluid ca-fade-in py-3">
    <div class="ca-upload-container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 fw-bold text-dark mb-1">Kanvas Görsellerini Yükle</h1>
                <p class="text-muted mb-0 small">Hazırlanan WebP paketini Railway kalıcı depolamasına aktarın.</p>
            </div>
            <a href="/Admin/Urun" class="btn btn-outline-secondary btn-sm px-3 rounded-pill">
                <i class="fas fa-arrow-left me-1"></i> Ürünlere Dön
            </a>
        </div>

        @if (ViewBag.Mesaj != null)
        {
            <div class="alert alert-success d-flex align-items-center gap-2 mb-3">
                <i class="fas fa-check-circle"></i>
                <span>@ViewBag.Mesaj</span>
            </div>
        }

        @if (ViewBag.Hata != null)
        {
            <div class="alert alert-danger d-flex align-items-center gap-2 mb-3">
                <i class="fas fa-triangle-exclamation"></i>
                <span>@ViewBag.Hata</span>
            </div>
        }

        <div class="ca-upload-card">
            <div class="ca-upload-card-header">
                <h2 class="ca-upload-card-title">
                    <i class="fas fa-file-zipper"></i>
                    <span>Görsel Paketi</span>
                </h2>
            </div>
            <div class="ca-upload-card-body">
                <div class="ca-upload-notice">
                    <i class="fas fa-circle-info fs-5"></i>
                    <span><strong>railway_kanvas_gorselleri.zip</strong> dosyasını seçin. Yükleme tamamlanana kadar bu sayfayı kapatmayın.</span>
                </div>

                <form id="kanvasUploadForm">
                    @Html.AntiForgeryToken()

                    <label class="form-label fw-semibold text-dark mb-2" for="zipDosyasi">ZIP Dosyası</label>

                    <div class="ca-upload-dropzone" id="dropZone">
                        <input type="file" id="zipDosyasi" name="zipDosyasi" accept=".zip,application/zip" class="d-none" required />
                        <div class="ca-upload-drop-icon">
                            <i class="fas fa-cloud-arrow-up"></i>
                        </div>
                        <div class="ca-upload-drop-title">ZIP dosyasını buraya sürükleyin veya seçmek için tıklayın</div>
                        <div class="ca-upload-drop-sub">En fazla 300 MB (.zip)</div>
                    </div>

                    <div id="fileInfo" class="ca-selected-file-bar d-none">
                        <div class="d-flex align-items-center gap-2 text-truncate">
                            <i class="fas fa-file-zipper text-primary"></i>
                            <span id="selectedFileName" class="fw-semibold text-dark text-truncate"></span>
                            <span id="selectedFileSize" class="text-muted small"></span>
                        </div>
                        <button type="button" id="btnChangeFile" class="btn btn-link btn-sm text-secondary p-0 text-decoration-none">
                            Değiştir
                        </button>
                    </div>

                    <div class="form-text text-muted mt-2">
                        En fazla 300 MB. Dosya bağlantı kopmalarını önlemek için 8 MB'lık parçalar halinde gönderilir.
                    </div>

                    <div id="uploadProgress" class="ca-progress-wrap d-none">
                        <div id="uploadProgressBar" class="ca-progress-bar" role="progressbar" style="width: 0%">0%</div>
                    </div>

                    <div id="uploadStatus" class="mt-3 fw-semibold small"></div>

                    <button id="uploadButton" class="ca-upload-btn" type="button">
                        <i class="fas fa-cloud-arrow-up"></i> Yüklemeyi Başlat
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="~/js/kanvas-upload.js" asp-append-version="true"></script>
