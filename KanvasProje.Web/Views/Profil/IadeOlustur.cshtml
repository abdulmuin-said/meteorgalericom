@model KanvasProje.Core.Varliklar.Siparis
@{
    ViewData["Title"] = "İade Talebi Oluştur";
}

<div class="bg-[#FDF6E3] border-b border-[#F5E6C8] py-3">
    <div class="container mx-auto px-4 flex items-center gap-2 text-xs text-[#333333]">
        <a href="/" class="hover:text-[#1B2A4A] transition-colors">Ana Sayfa</a>
        <span>/</span>
        <a href="/Profil" class="hover:text-[#1B2A4A] transition-colors">Hesabım</a>
        <span>/</span>
        <a href="/Profil/Siparislerim" class="hover:text-[#1B2A4A] transition-colors">Siparişlerim</a>
        <span>/</span>
        <span class="text-[#1B2A4A] font-medium">İade Talebi</span>
    </div>
</div>

<div class="container mx-auto px-4 py-10 max-w-3xl">
    <h1 class="font-serif text-3xl text-[#1B2A4A] mb-6">İade Talebi Oluştur</h1>
    
    <div class="bg-white border border-[#F5E6C8] rounded-lg p-6 mb-8">
        <h3 class="font-bold text-[#1B2A4A] mb-4 border-b border-[#F5E6C8] pb-2">Sipariş Bilgileri</h3>
        <p class="text-sm text-[#333333] mb-2"><strong>Sipariş No:</strong> @Model.SiparisNo</p>
        <p class="text-sm text-[#333333] mb-2"><strong>Tarih:</strong> @Model.OlusturulmaTarihi.ToTurkeyString("dd.MM.yyyy")</p>
        <p class="text-sm text-[#333333]"><strong>Tutar:</strong> @Model.ToplamTutar.ToString("N2") TL</p>
    </div>

    <form asp-action="IadeOlustur" method="post" class="space-y-6">
        @Html.AntiForgeryToken()
        <input type="hidden" name="SiparisId" value="@Model.Id" />
        
        <div>
            <label class="block text-xs uppercase tracking-widest text-[#1B2A4A] font-medium mb-2">İade Nedeni</label>
            <select name="Neden" required class="w-full border border-[#F5E6C8] rounded px-4 py-3 text-sm focus:ring-1 focus:ring-[#C0392B] focus:border-[#C0392B] outline-none bg-[#FFFBF0]">
                <option value="">Seçiniz</option>
                <option value="Hasarlı Ürün">Ürün hasarlı geldi</option>
                <option value="Yanlış Ürün">Yanlış ürün gönderildi</option>
                <option value="Beklentimi Karşılamadı">Ürün beklentimi karşılamadı</option>
                <option value="Vazgeçtim">Satın almaktan vazgeçtim</option>
            </select>
        </div>

        <div>
            <label class="block text-xs uppercase tracking-widest text-[#1B2A4A] font-medium mb-2">Açıklama (İsteğe Bağlı)</label>
            <textarea name="Aciklama" rows="4" class="w-full border border-[#F5E6C8] rounded px-4 py-3 text-sm focus:ring-1 focus:ring-[#C0392B] focus:border-[#C0392B] outline-none bg-[#FFFBF0] resize-none" placeholder="İade talebinizle ilgili eklemek istedikleriniz..."></textarea>
        </div>

        <div>
            <label class="block text-xs uppercase tracking-widest text-[#1B2A4A] font-medium mb-2">IBAN (İsteğe Bağlı)</label>
            <input name="IBAN" class="w-full border border-[#F5E6C8] rounded px-4 py-3 text-sm focus:ring-1 focus:ring-[#C0392B] focus:border-[#C0392B] outline-none bg-[#FFFBF0]" placeholder="TR..." />
        </div>

        <div class="flex gap-4">
            <button type="submit" class="bg-[#1B2A4A] text-white px-8 py-3 text-xs tracking-widest uppercase rounded hover:bg-[#1c2001] transition-colors">
                Talebi Gönder
            </button>
            <a href="/Profil/Siparislerim" class="bg-white border border-[#F5E6C8] text-[#1B2A4A] px-8 py-3 text-xs tracking-widest uppercase rounded hover:bg-[#FFFBF0] transition-colors inline-flex items-center">
                İptal
            </a>
        </div>
    </form>
</div>
