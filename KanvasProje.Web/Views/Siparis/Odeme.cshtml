@model KanvasProje.Core.Varliklar.Siparis
@using KanvasProje.Core.Varliklar
@{
    ViewData["Title"] = "Güvenli Ödeme";

    decimal araToplam = ViewBag.AraToplam ?? 0;
    decimal indirim = ViewBag.IndirimTutari ?? 0;
    decimal genelToplam = ViewBag.ToplamTutar ?? 0;
    string? kuponKodu = ViewBag.KuponKodu as string;
    var sepetItems = ViewBag.SepetItems as List<KanvasProje.Core.Varliklar.SepetItem> ?? new List<KanvasProje.Core.Varliklar.SepetItem>();

    var kayitliAdresler = ViewBag.KayitliAdresler as List<KanvasProje.Core.Varliklar.Adres>;
    bool girisYapmis = User.Identity?.IsAuthenticated == true;
    var sehirler = new[]
    {
        "Adana", "Adıyaman", "Afyonkarahisar", "Ağrı", "Aksaray", "Amasya", "Ankara", "Antalya", "Ardahan", "Artvin",
        "Aydın", "Balıkesir", "Bartın", "Batman", "Bayburt", "Bilecik", "Bingöl", "Bitlis", "Bolu", "Burdur",
        "Bursa", "Çanakkale", "Çankırı", "Çorum", "Denizli", "Diyarbakır", "Düzce", "Edirne", "Elazığ", "Erzincan",
        "Erzurum", "Eskişehir", "Gaziantep", "Giresun", "Gümüşhane", "Hakkari", "Hatay", "Iğdır", "Isparta", "İstanbul",
        "İzmir", "Kahramanmaraş", "Karabük", "Karaman", "Kars", "Kastamonu", "Kayseri", "Kırıkkale", "Kırklareli", "Kırşehir",
        "Kilis", "Kocaeli", "Konya", "Kütahya", "Malatya", "Manisa", "Mardin", "Mersin", "Muğla", "Muş",
        "Nevşehir", "Niğde", "Ordu", "Osmaniye", "Rize", "Sakarya", "Samsun", "Siirt", "Sinop", "Sivas",
        "Şanlıurfa", "Şırnak", "Tekirdağ", "Tokat", "Trabzon", "Tunceli", "Uşak", "Van", "Yalova", "Yozgat",
        "Zonguldak"
    };
}

<!-- Breadcrumb -->
<div class="bg-[#FDF6E3] border-b border-[#F5E6C8] py-4">
    <div class="container mx-auto px-4 flex items-center justify-center gap-4 text-xs tracking-widest uppercase">
        <a href="/Sepet" class="text-[#333333] hover:text-[#1B2A4A] transition-colors flex items-center gap-2">
            <span class="w-5 h-5 rounded-full bg-[#F5E6C8] text-[#333333] flex items-center justify-center font-bold">1</span> Sepet
        </a>
        <span class="text-[#F5E6C8]">/</span>
        <span class="text-[#1B2A4A] font-bold flex items-center gap-2">
            <span class="w-5 h-5 rounded-full bg-[#1B2A4A] text-white flex items-center justify-center font-bold">2</span> Ödeme & Teslimat
        </span>
    </div>
</div>

<div class="container mx-auto px-4 py-12 md:py-16">
    <div class="text-center mb-12">
        <h1 class="font-serif text-3xl md:text-5xl text-[#1B2A4A] mb-4">Güvenli Ödeme</h1>
        <p class="text-sm text-[#333333] max-w-2xl mx-auto">Teslimat bilgilerinizi doğrulayın ve siparişinizi güvenle tamamlayın.</p>
    </div>

    <div class="flex flex-col lg:flex-row gap-12 lg:gap-16 max-w-6xl mx-auto">
        <!-- Sol Form Alanı -->
        <div class="lg:w-2/3 space-y-12">
            
            @if (kayitliAdresler != null && kayitliAdresler.Any())
            {
                <section>
                    <h2 class="font-serif text-2xl text-[#1B2A4A] mb-6 flex items-center gap-3 border-b border-[#F5E6C8] pb-4">
                        <i class="fas fa-address-book text-[#3A7CA5]"></i> Kayıtlı Adresleriniz
                    </h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        @foreach (var adres in kayitliAdresler)
                        {
                            <label class="relative border border-[#F5E6C8] rounded-lg p-5 cursor-pointer transition-colors hover:border-[#3A7CA5] has-[:checked]:border-[#1B2A4A] has-[:checked]:bg-[#FFFBF0] group block">
                                <input type="radio" name="kayitliAdresSecimi" class="absolute opacity-0 w-0 h-0 peer" onclick="selectAddress('@adres.AdSoyad', '@adres.Telefon', '@adres.Sehir', '@adres.Ilce', '@adres.AcikAdres')">
                                <div class="flex items-start gap-3">
                                    <span class="address-radio w-5 h-5 rounded-full border-2 border-[#3A7CA5] flex items-center justify-center bg-white transition-all duration-200">
                                        <span class="address-radio-inner w-2.5 h-2.5 rounded-full bg-[#3A7CA5] opacity-0 scale-0 transition-all duration-200"></span>
                                    </span>
                                    <div class="flex-1">
                                        <div class="text-sm font-semibold text-[#1B2A4A] mb-2 uppercase tracking-wide">@adres.Baslik</div>
                                        <div class="text-sm text-[#333333] mb-1">@adres.AdSoyad</div>
                                        <div class="text-sm text-[#333333] mb-1">@adres.Telefon</div>
                                        <div class="text-sm text-[#333333] mb-2">@adres.Sehir / @adres.Ilce</div>
                                        <div class="text-xs text-[#333333] leading-relaxed line-clamp-2">@adres.AcikAdres</div>
                                    </div>
                                </div>
                            </label>
                        }
                    </div>
                </section>
            }

            <section>
                <h2 class="font-serif text-2xl text-[#1B2A4A] mb-6 flex items-center gap-3 border-b border-[#F5E6C8] pb-4">
                    <i class="fas fa-truck text-[#3A7CA5]"></i> Teslimat Bilgileri
                </h2>

                @if (ViewBag.FormHata != null || !ViewData.ModelState.IsValid)
                {
                    <div class="mb-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
                        <div class="font-semibold">@((string?)ViewBag.FormHata ?? "Lutfen form bilgilerini kontrol edin.")</div>
                        <div asp-validation-summary="All" class="mt-2"></div>
                    </div>
                }

                <form asp-action="Odeme" method="post" id="odemeForm">
                    @if (girisYapmis)
                    {
                        <input type="hidden" asp-for="Eposta" />
                    }

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-6">
                        <div class="md:col-span-2">
                            <label class="block text-xs uppercase tracking-widest text-[#1B2A4A] font-medium mb-2" for="MusteriAdSoyad">Ad Soyad</label>
                            <input asp-for="MusteriAdSoyad" id="MusteriAdSoyad" class="w-full bg-transparent border-0 border-b border-[#F5E6C8] px-0 py-2 focus:ring-0 focus:border-[#1B2A4A] text-[#1B2A4A] transition-colors" placeholder="Adınız ve soyadınız" required>
                        </div>

                        <div>
                            <label class="block text-xs uppercase tracking-widest text-[#1B2A4A] font-medium mb-2" for="Eposta">E-posta</label>
                            @if (girisYapmis)
                            {
                                <input value="@Model.Eposta" class="w-full bg-transparent border-0 border-b border-[#F5E6C8] px-0 py-2 text-[#333333] cursor-not-allowed" readonly>
                                <div class="mt-2 text-[10px] uppercase tracking-widest text-[#3A7CA5]">Kayıtlı e-posta adresiniz kullanılacak.</div>
                            }
                            else
                            {
                                <input asp-for="Eposta" id="Eposta" type="email" class="w-full bg-transparent border-0 border-b border-[#F5E6C8] px-0 py-2 focus:ring-0 focus:border-[#1B2A4A] text-[#1B2A4A] transition-colors" placeholder="ornek@mail.com" required>
                            }
                        </div>

                        <div>
                            <label class="block text-xs uppercase tracking-widest text-[#1B2A4A] font-medium mb-2" for="Telefon">Telefon</label>
                            <input asp-for="Telefon" id="Telefon" class="w-full bg-transparent border-0 border-b border-[#F5E6C8] px-0 py-2 focus:ring-0 focus:border-[#1B2A4A] text-[#1B2A4A] transition-colors" placeholder="5XX XXX XX XX" maxlength="13" required>
                        </div>

                        <div>
                            <label class="block text-xs uppercase tracking-widest text-[#1B2A4A] font-medium mb-2" for="Sehir">Şehir</label>
                            <select asp-for="Sehir" id="Sehir" class="w-full bg-transparent border-0 border-b border-[#F5E6C8] px-0 py-2 focus:ring-0 focus:border-[#1B2A4A] text-[#1B2A4A] transition-colors" required>
                                <option value="">Şehir seçiniz</option>
                                @foreach (var sehir in sehirler)
                                {
                                    <option value="@sehir">@sehir</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label class="block text-xs uppercase tracking-widest text-[#1B2A4A] font-medium mb-2" for="Ilce">İlçe</label>
                            <input asp-for="Ilce" id="Ilce" class="w-full bg-transparent border-0 border-b border-[#F5E6C8] px-0 py-2 focus:ring-0 focus:border-[#1B2A4A] text-[#1B2A4A] transition-colors" placeholder="İlçe adı" required>
                        </div>

                        <div class="md:col-span-2">
                            <label class="block text-xs uppercase tracking-widest text-[#1B2A4A] font-medium mb-2" for="AcikAdres">Açık Adres</label>
                            <textarea asp-for="AcikAdres" id="AcikAdres" class="w-full bg-transparent border-0 border-b border-[#F5E6C8] px-0 py-2 focus:ring-0 focus:border-[#1B2A4A] text-[#1B2A4A] transition-colors resize-none h-24" placeholder="Mahalle, sokak, apartman, daire numarası ve ek adres bilgileri" required></textarea>
                        </div>

                        @if (girisYapmis)
                        {
                            <div class="md:col-span-2 mt-4 bg-white border border-[#F5E6C8] p-5 rounded-lg">
                                <label class="flex items-center gap-3 cursor-pointer group">
                                    <input type="checkbox" id="AdresiKaydet" name="AdresiKaydet" value="true" class="w-4 h-4 text-[#1B2A4A] border-[#F5E6C8] rounded focus:ring-[#1B2A4A]">
                                    <span class="text-sm font-medium text-[#1B2A4A] group-hover:text-[#1B2A4A] transition-colors">Bu adresi hesabıma kaydetmek istiyorum</span>
                                </label>
                                
                                <div id="adresBaslikWrapper" class="mt-4 hidden transition-all duration-300">
                                    <label class="block text-xs uppercase tracking-widest text-[#1B2A4A] font-medium mb-2" for="YeniAdresBasligi">Adres Başlığı</label>
                                    <input type="text" id="YeniAdresBasligi" name="YeniAdresBasligi" class="w-full bg-transparent border-0 border-b border-[#F5E6C8] px-0 py-2 focus:ring-0 focus:border-[#1B2A4A] text-[#1B2A4A] transition-colors" placeholder="Örn: Evim, Ofisim">
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Kargo Firması Seçimi -->
                    <div class="mt-12">
                        <h2 class="font-serif text-2xl text-[#1B2A4A] mb-6 flex items-center gap-3 border-b border-[#F5E6C8] pb-4">
                            <i class="fas fa-truck-fast text-[#3A7CA5]"></i> Kargo Firması Seçiniz
                        </h2>
                        
                        @{
                            var kargoFirmalari = ViewBag.KargoFirmalari as List<KargoFirmasi> ?? new List<KargoFirmasi>();
                            var ucretsizKargoLimiti = (decimal)(ViewBag.UcretsizKargoLimiti ?? 500);
                            var isFreeShipping = (araToplam - indirim) >= ucretsizKargoLimiti;
                        }

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            @foreach (var kargo in kargoFirmalari)
                            {
                                var kargoFiyat = isFreeShipping ? 0 : kargo.Fiyat;
                                var isChecked = Model.KargoFirmasiId > 0 ? (kargo.Id == Model.KargoFirmasiId) : kargo.VarsayilanMi;
                                var checkedAttr = isChecked ? "checked" : null;
                                
                                <label class="group relative cursor-pointer border border-[#F5E6C8] rounded-lg p-4 bg-white flex items-center justify-between gap-4 transition-all hover:border-[#3A7CA5] has-[:checked]:border-[#1B2A4A] has-[:checked]:bg-[#FFFBF0]">
                                    <div class="flex items-center gap-3">
                                        <input type="radio" name="KargoFirmasiId" value="@kargo.Id" class="kargo-radio w-4 h-4 text-[#1B2A4A] border-[#F5E6C8] focus:ring-[#1B2A4A]" checked="@checkedAttr" data-price="@kargoFiyat" data-name="@kargo.Ad" />
                                        <div>
                                            <div class="text-sm font-semibold text-[#1B2A4A]">@kargo.Ad</div>
                                            <div class="text-[11px] text-[#6f6a5e]">@kargo.Telefon</div>
                                        </div>
                                    </div>
                                    <div class="text-right">
                                        @if (kargoFiyat == 0)
                                        {
                                            <span class="text-xs font-bold text-green-600 uppercase">Ücretsiz</span>
                                        }
                                        else
                                        {
                                            <span class="text-sm font-semibold text-[#1B2A4A]">₺@kargoFiyat.ToString("N2")</span>
                                        }
                                    </div>
                                </label>
                            }
                        </div>
                    </div>

                    <div class="mt-12">
                        <h2 class="font-serif text-2xl text-[#1B2A4A] mb-6 flex items-center gap-3 border-b border-[#F5E6C8] pb-4">
                            <i class="fas fa-credit-card text-[#3A7CA5]"></i> Ödeme Yöntemi
                        </h2>
                        
                        <div class="border border-[#F5E6C8] rounded-lg p-6 bg-white relative overflow-hidden">
                            <div class="absolute top-0 right-0 bg-[#3A7CA5] text-white text-[10px] uppercase tracking-widest px-3 py-1 font-bold rounded-bl-lg">256-Bit SSL</div>
                            
                            <div class="flex items-center gap-4 mb-4">
                                <i class="fas fa-shield-alt text-[#1B2A4A] text-3xl"></i>
                                <div>
                                    <h6 class="text-base font-bold text-[#1B2A4A]">Sipariş Talebi</h6>
                                    <p class="text-xs text-[#333333]">Siparişiniz alınır, ödeme/onay süreci için ekibimiz sizinle iletişime geçebilir.</p>
                                </div>
                            </div>

                            <p class="text-sm text-[#333333] mb-6 border-t border-[#F5E6C8] pt-4">
                                Siparişi tamamla butonuna tıkladığınızda siparişiniz oluşturulur. Ödeme ve onay süreci tamamlandığında sizinle iletişime geçilecektir.
                            </p>

                            <label class="flex items-start gap-3 cursor-pointer group mt-4 bg-[#FFFBF0] p-4 rounded border border-[#F5E6C8]">
                                <input type="checkbox" id="terms" required class="w-4 h-4 mt-0.5 text-[#1B2A4A] border-[#F5E6C8] rounded focus:ring-[#1B2A4A]">
                                <span class="text-sm leading-relaxed text-[#333333]">
                                    <a href="/Kurumsal/Gizlilik" class="text-[#1B2A4A] font-semibold hover:text-[#3A7CA5] transition-colors underline decoration-1 underline-offset-2">Gizlilik Politikası</a> ve 
                                    <a href="/Kurumsal/KullaniciSozlesmesi" class="text-[#1B2A4A] font-semibold hover:text-[#3A7CA5] transition-colors underline decoration-1 underline-offset-2">Kullanıcı Sözleşmesi</a> şartlarını okudum, onaylıyorum.
                                </span>
                            </label>
                        </div>
                    </div>

                    <button type="submit" class="w-full mt-8 bg-[#1B2A4A] text-white text-sm font-medium tracking-widest uppercase py-4 rounded hover:bg-[#1c2001] transition-colors flex items-center justify-center gap-3">
                        <i class="fas fa-check"></i> Siparişi Oluştur - <span id="checkoutBtnTotal">@genelToplam.ToString("N2")</span> TL
                    </button>
                </form>
            </section>
        </div>

        <!-- Sağ Sipariş Özeti -->
        <div class="lg:w-1/3">
            <div class="sticky top-8 bg-white border border-[#F5E6C8] rounded-lg p-6 lg:p-8">
                <h3 class="font-serif text-2xl text-[#1B2A4A] mb-6 pb-4 border-b border-[#F5E6C8]">Sipariş Özeti</h3>
                
                @if (sepetItems.Any())
                {
                    <div class="mb-6 space-y-3 border-b border-[#F5E6C8] pb-5">
                        @foreach (var item in sepetItems)
                        {
                            <div class="flex gap-3">
                                <div class="h-14 w-14 shrink-0 overflow-hidden rounded bg-[#FDF6E3]">
                                    <img src="@item.UrunResimUrl" alt="@item.UrunBaslik" class="h-full w-full object-cover" loading="lazy" decoding="async" />
                                </div>
                                <div class="min-w-0 flex-1">
                                    <div class="line-clamp-2 text-xs font-semibold text-[#1B2A4A]">@item.UrunBaslik</div>
                                    @if (!string.IsNullOrWhiteSpace(item.SecenekAdi))
                                    {
                                        <div class="mt-1 text-[11px] leading-snug text-[#6f6a5e]">@item.SecenekAdi</div>
                                    }
                                    <div class="mt-1 flex justify-between gap-2 text-xs text-[#333333]">
                                        <span>x @item.Adet</span>
                                        <span>@item.Toplam.ToString("N2") TL</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

                <div class="space-y-4 mb-6 text-sm">
                    <div class="flex justify-between text-[#333333]">
                        <span>Ara Toplam</span>
                        <span>@araToplam.ToString("N2") TL</span>
                    </div>

                    @if (indirim > 0)
                    {
                        <div class="flex justify-between text-[#3A7CA5] font-medium">
                            <span>İndirim (@kuponKodu)</span>
                            <span>-@indirim.ToString("N2") TL</span>
                        </div>
                    }

                    <div class="flex justify-between text-[#333333]">
                        <span>Kargo Ücreti</span>
                        <span id="checkoutKargoUcreti" class="text-[#1B2A4A] font-medium">@((ViewBag.GosterilecekKargoBedeli == 0) ? "Ücretsiz" : $"₺{((decimal)ViewBag.GosterilecekKargoBedeli).ToString("N2")}")</span>
                    </div>
                </div>

                <div class="flex justify-between items-end border-t border-[#F5E6C8] pt-6 mb-8">
                    <span class="text-sm text-[#333333] uppercase tracking-wider font-medium">Genel Toplam</span>
                    <span id="checkoutGenelToplam" class="text-4xl font-bold text-[#1B2A4A] tracking-tight">@genelToplam.ToString("N2") <span class="text-lg font-normal text-[#333333]">TL</span></span>
                </div>

                <div class="space-y-4 pt-6 border-t border-[#F5E6C8]">
                    <!-- İyzico & SSL Güvencesi -->
                    <div class="flex items-start gap-3 bg-white p-3.5 rounded-xl border border-[#F5E6C8] shadow-xs">
                        <div class="w-8 h-8 rounded-full bg-[#EBF5FB] border border-[#01ADD3]/30 flex items-center justify-center shrink-0 text-[#01ADD3]">
                            <i class="fas fa-shield-halved text-sm"></i>
                        </div>
                        <div>
                            <p class="text-xs font-bold text-[#1B2A4A] uppercase tracking-wider mb-0.5 flex items-center gap-1.5">
                                BDDK Lisanslı İyzico Güvencesi
                                <span class="bg-emerald-100 text-emerald-800 text-[9px] px-1.5 py-0.2 rounded font-semibold uppercase">256-Bit SSL</span>
                            </p>
                            <p class="text-[11px] text-[#555555] leading-relaxed">Kart bilgileriniz sunucularımızda saklanmaz. Ödemeniz 3D Secure ve banka düzeyinde güvenlik protokolüyle tamamlanır.</p>
                        </div>
                    </div>

                    <!-- Hasarsız Teslimat Garantisi -->
                    <div class="flex items-start gap-3 bg-white p-3.5 rounded-xl border border-[#F5E6C8] shadow-xs">
                        <div class="w-8 h-8 rounded-full bg-[#FEF9E7] border border-amber-300 flex items-center justify-center shrink-0 text-amber-600">
                            <i class="fas fa-box-open text-sm"></i>
                        </div>
                        <div>
                            <p class="text-xs font-bold text-[#1B2A4A] uppercase tracking-wider mb-0.5 flex items-center gap-1.5">
                                Hasarsız Teslimat Garantisi
                                <span class="bg-amber-100 text-amber-800 text-[9px] px-1.5 py-0.2 rounded font-semibold uppercase">Sıfır Risk</span>
                            </p>
                            <p class="text-[11px] text-[#555555] leading-relaxed">Tablo, cam ve ayna ürünleriniz petek korumalı özel sandıklarla paketlenir. Kargo esnasında hasar görürse <strong>koşulsuz yenisi ücretsiz</strong> gönderilir.</p>
                        </div>
                    </div>

                    <!-- 14 Gün Kolay İade -->
                    <div class="flex items-start gap-3 bg-white p-3.5 rounded-xl border border-[#F5E6C8] shadow-xs">
                        <div class="w-8 h-8 rounded-full bg-[#EBF5FB] border border-[#3A7CA5]/30 flex items-center justify-center shrink-0 text-[#3A7CA5]">
                            <i class="fas fa-arrow-rotate-left text-sm"></i>
                        </div>
                        <div>
                            <p class="text-xs font-bold text-[#1B2A4A] uppercase tracking-wider mb-0.5">14 Gün Kolay İade & Değişim</p>
                            <p class="text-[11px] text-[#555555] leading-relaxed">Memnun kalmadığınız durumda yasal 14 gün içerisinde kolay iade veya değişim hakkınız saklıdır.</p>
                        </div>
                    </div>

                    <!-- Kart ve Ödeme Logoları -->
                    <div class="pt-2 flex items-center justify-center gap-4 text-gray-400 text-lg">
                        <i class="fab fa-cc-visa hover:text-[#1B2A4A] transition-colors" title="Visa"></i>
                        <i class="fab fa-cc-mastercard hover:text-[#1B2A4A] transition-colors" title="Mastercard"></i>
                        <i class="fab fa-cc-amex hover:text-[#1B2A4A] transition-colors" title="American Express"></i>
                        <span class="text-[10px] font-bold text-[#3A7CA5] border border-[#3A7CA5] rounded px-1 py-0.5 uppercase tracking-wider">TROY</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function selectAddress(ad, tel, sehir, ilce, acikAdres) {
        document.getElementById("MusteriAdSoyad").value = ad;
        document.getElementById("Telefon").value = tel;
        document.getElementById("Sehir").value = sehir;
        document.getElementById("Ilce").value = ilce;
        document.getElementById("AcikAdres").value = acikAdres;

        if (window.showToast) {
            window.showToast('Adres bilgileri forma aktarıldı.', 'success');
        }
    }

    const adresKaydetCheckbox = document.getElementById('AdresiKaydet');
    if (adresKaydetCheckbox) {
        adresKaydetCheckbox.addEventListener('change', function () {
            const target = document.getElementById('adresBaslikWrapper');
            if (!target) return;

            if (this.checked) {
                target.classList.remove('hidden');
            } else {
                target.classList.add('hidden');
            }
        });
    }

    const telefonInput = document.getElementById('Telefon');
    if (telefonInput) {
        telefonInput.addEventListener('input', function (e) {
            let value = e.target.value.replace(/\D/g, '');

            if (value.startsWith('0')) {
                value = value.substring(1);
            }

            if (value.length > 10) {
                value = value.substring(0, 10);
            }

            if (value.length > 6) {
                value = value.replace(/(\d{3})(\d{3})(\d{2})(\d{2})/, '$1 $2 $3 $4');
            } else if (value.length > 3) {
                value = value.replace(/(\d{3})(\d{3})/, '$1 $2');
            }

            e.target.value = value;
        });
    }

    // Form submission validation UI
    const form = document.getElementById('odemeForm');
    form.addEventListener('submit', function(e) {
        if (!form.checkValidity()) {
            e.preventDefault();
            if (window.showToast) {
                window.showToast('Lütfen tüm zorunlu alanları eksiksiz doldurun.', 'error');
            }
        }
    });

    // Address radio button visual update
    document.querySelectorAll('input[name="kayitliAdresSecimi"]').forEach(function(radio) {
        radio.addEventListener('change', function() {
            document.querySelectorAll('.address-radio-inner').forEach(function(inner) {
                inner.classList.remove('opacity-100', 'scale-100');
                inner.classList.add('opacity-0', 'scale-0');
            });
            var container = this.closest('label').querySelector('.address-radio-inner');
            if (container) {
                container.classList.remove('opacity-0', 'scale-0');
                container.classList.add('opacity-100', 'scale-100');
            }
        });
    });

    document.addEventListener("DOMContentLoaded", function () {
        const kargoRadios = document.querySelectorAll(".kargo-radio");
        const kargoDisplay = document.getElementById("checkoutKargoUcreti");
        const totalDisplay = document.getElementById("checkoutGenelToplam");
        const btnTotalDisplay = document.getElementById("checkoutBtnTotal");

        const subtotal = parseFloat("@((araToplam - indirim).ToString(System.Globalization.CultureInfo.InvariantCulture))");

        function updateCheckoutTotals() {
            const selectedRadio = document.querySelector(".kargo-radio:checked");
            if (!selectedRadio) return;

            const kargoPrice = parseFloat(selectedRadio.getAttribute("data-price")) || 0;
            const genelToplamVal = subtotal + kargoPrice;

            if (kargoDisplay) {
                if (kargoPrice === 0) {
                    kargoDisplay.textContent = "Ücretsiz";
                    kargoDisplay.className = "text-green-600 font-bold uppercase";
                } else {
                    kargoDisplay.textContent = "₺" + kargoPrice.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                    kargoDisplay.className = "text-[#1B2A4A] font-medium";
                }
            }

            if (totalDisplay) {
                totalDisplay.innerHTML = genelToplamVal.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' <span class="text-lg font-normal text-[#333333]">TL</span>';
            }

            if (btnTotalDisplay) {
                btnTotalDisplay.textContent = genelToplamVal.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }
        }

        kargoRadios.forEach(radio => {
            radio.addEventListener("change", updateCheckoutTotals);
        });

        updateCheckoutTotals();
    });
</script>
