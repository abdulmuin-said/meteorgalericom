    ViewData["Title"] = "Kullanıcı Sözleşmesi";
}

<!-- Breadcrumb -->
<div class="bg-[#FDF6E3] border-b border-[#F5E6C8] py-3">
    <div class="container mx-auto px-4 flex items-center gap-2 text-xs text-[#666666]">
        <a href="/" class="hover:text-[#C0392B] transition-colors">Ana Sayfa</a>
        <span>/</span>
        <span class="text-[#1B2A4A] font-medium">Kullanıcı Sözleşmesi</span>
    </div>
</div>

<div class="container mx-auto px-4 py-16 max-w-4xl">
    <div class="text-center mb-12">
        <h1 class="font-serif text-3xl md:text-5xl text-[#1B2A4A] mb-4">Kullanıcı Sözleşmesi</h1>
        <div class="w-16 h-1 bg-[#C0392B] mx-auto"></div>
    </div>

    <div class="bg-white border border-[#F5E6C8] rounded-sm p-8 md:p-12 shadow-sm prose prose-sm md:prose-base max-w-none prose-headings:font-serif prose-headings:text-[#1B2A4A] prose-a:text-[#C0392B] prose-strong:text-[#1B2A4A]">
        <h2>1. Taraflar</h2>
        <p>İşbu Kullanıcı Sözleşmesi ("Sözleşme"), MeteorGaleri tarafından işletilen web sitesini ("Site") kullanan gerçek kişi ("Kullanıcı") ile MeteorGaleri arasında akdedilmiştir.</p>

        <h2>2. Sözleşmenin Konusu</h2>
        <p>Bu Sözleşme, Kullanıcı'nın Site'yi kullanım koşullarını ve bu kapsamdaki karşılıklı hak ve yükümlülükleri düzenlemektedir.</p>

        <h2>3. Kullanım Koşulları</h2>
        <ul>
            <li>Site yalnızca kişisel ve ticari olmayan amaçlarla kullanılabilir.</li>
            <li>Kullanıcı, siteyi yasalara aykırı amaçlarla kullanamaz.</li>
            <li>Siteye zarar verecek her türlü eylem yasaktır.</li>
        </ul>

        <h2>4. Gizlilik</h2>
        <p>Kullanıcıya ait kişisel bilgiler <a href="/Kurumsal/Gizlilik">Gizlilik Politikası</a> kapsamında korunmaktadır.</p>

        <h2>5. Sorumluluk Sınırı</h2>
        <p>MeteorGaleri, Kullanıcı'nın siteyi kullanımından doğan dolaylı zararlardan sorumlu tutulamaz.</p>

        <h2>6. Değişiklikler</h2>
        <p>MeteorGaleri, bu Sözleşme'yi önceden bildirimde bulunmaksızın değiştirme hakkını saklı tutar. Değişiklikler yayımlandığı tarihten itibaren geçerlidir.</p>

        <h2>7. İletişim</h2>
        <p>Sözleşme ile ilgili sorularınız için <a href="/Kurumsal/Iletisim">İletişim</a> sayfamızdan bize ulaşabilirsiniz.</p>
    </div>
</div>
